{
  "expo": {
    "name": "ACC",
    "slug": "acc-android",
    "scheme": "acc",
    "version": "0.6.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-secure-store",
      "./plugins/with-runtime-network"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.agentcommandcenter.acc",
      "versionCode": 6,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#10151d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
